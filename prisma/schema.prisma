// Jigsaw Puzzle Marketplace — data model.
//
// Two structural decisions drive everything:
//   1. Catalog (title-level metadata) is separated from Inventory (physical
//      copies). An InventoryItem is either USER-owned (P2P) or WAREHOUSE-owned.
//   2. CatalogItem is category-generic (puzzles now; board/card games later)
//      via a `category` enum + a typed `attributes` JSON blob validated per
//      category in src/lib/categories/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  MEMBER
  ADMIN
}

enum Category {
  JIGSAW_PUZZLE
  BOARD_GAME
  CARD_GAME
}

enum InventorySource {
  USER
  WAREHOUSE
}

enum InventoryStatus {
  AVAILABLE
  RESERVED // an active rental holds it
  UNAVAILABLE // owner temporarily delisted
}

enum RentalStatus {
  REQUESTED
  APPROVED
  DECLINED
  CANCELED
  SHIPPED_TO_BORROWER
  IN_HAND
  RETURN_SHIPPED
  RETURNED
  DISPUTED
  COMPLETED
}

enum ShipmentDirection {
  OUTBOUND // lender/warehouse -> borrower
  RETURN // borrower -> lender/warehouse
}

enum ShipmentStatus {
  CREATED
  IN_TRANSIT
  DELIVERED
}

enum PayerRole {
  BORROWER
  LENDER
  PLATFORM
}

enum DepositStatus {
  HELD
  REFUNDED
  PARTIALLY_FORFEITED
  FORFEITED
}

enum PaymentType {
  SUBSCRIPTION
  RENTAL_FEE
  DEPOSIT_HOLD
  DEPOSIT_REFUND
  SHIPPING
  PAYOUT
  DEPOSIT_FORFEIT
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

// ---------------------------------------------------------------------------
// Users & auth (Auth.js Prisma adapter compatible)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          Role      @default(MEMBER)
  emailVerified DateTime?
  image         String?

  // Shipping address
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String? @default("US")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  inventory    InventoryItem[]
  subscription Subscription?
  rentalsAsBorrower Rental[] @relation("BorrowerRentals")
  favorites    Favorite[]
  reviews      Review[]
  payments     SimulatedPayment[]
  payouts      RevenueShareEntry[] @relation("OwnerPayouts")
  disputesOpened Dispute[] @relation("DisputeOpenedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Catalog (title-level) vs Inventory (physical copies)
// ---------------------------------------------------------------------------

model CatalogItem {
  id        String   @id @default(cuid())
  category  Category @default(JIGSAW_PUZZLE)
  title     String
  brand     String?
  imageUrl  String?
  // Category-specific metadata, validated by src/lib/categories/<category>.
  // e.g. { "pieceCount": 1000 } for puzzles.
  attributes Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory InventoryItem[]
  favorites Favorite[]
  reviews   Review[]

  @@index([category])
  @@unique([category, title, brand])
}

model InventoryItem {
  id        String          @id @default(cuid())
  catalogItemId String
  source    InventorySource
  ownerId   String? // null when source == WAREHOUSE
  status    InventoryStatus @default(AVAILABLE)

  condition String? // free-text, owner-declared
  depositCents    Int @default(2000)
  ratePerWeekCents Int @default(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  owner       User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rentals     Rental[]

  @@index([status])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id           String  @id @default(cuid())
  key          String  @unique // starter | plus | pro
  name         String
  priceCents   Int
  monthlyCredits Int   @default(0)
  active       Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  planId    String
  active    Boolean  @default(true)
  creditsRemaining Int @default(0)
  currentPeriodEnd DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
}

// ---------------------------------------------------------------------------
// Rentals & the money/state-machine graph
// ---------------------------------------------------------------------------

model Rental {
  id              String       @id @default(cuid())
  inventoryItemId String
  borrowerId      String
  status          RentalStatus @default(REQUESTED)

  // Period & pricing (see src/lib/services/pricing.ts)
  periodDays      Int
  quotedFeeCents  Int          @default(0) // locked at APPROVED
  creditsApplied  Int          @default(0)

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  dueAt       DateTime?
  shippedAt   DateTime?
  receivedAt  DateTime?
  returnShippedAt DateTime?
  returnedAt  DateTime?
  completedAt DateTime?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  borrower      User          @relation("BorrowerRentals", fields: [borrowerId], references: [id])

  deposit       Deposit?
  shipments     Shipment[]
  conditionProof ConditionProof?
  experience    RentalExperience?
  dispute       Dispute?
  revenueShare  RevenueShareEntry?
  payments      SimulatedPayment[]

  @@index([status])
  @@index([borrowerId])
}

model Deposit {
  id           String        @id @default(cuid())
  rentalId     String        @unique
  amountCents  Int
  status       DepositStatus @default(HELD)
  forfeitedCents Int         @default(0)
  resolvedAt   DateTime?
  note         String?

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
}

model Shipment {
  id          String            @id @default(cuid())
  rentalId    String
  direction   ShipmentDirection
  status      ShipmentStatus    @default(CREATED)
  costCents   Int
  paidByUserId String? // null when PLATFORM pays
  paidByRole  PayerRole
  trackingCode String?
  createdAt   DateTime          @default(now())
  deliveredAt DateTime?

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@unique([rentalId, direction])
}

// Return-time photo proof (assembled puzzle / laid-out components).
model ConditionProof {
  id         String   @id @default(cuid())
  rentalId   String   @unique
  imageUrl   String
  note       String?
  uploadedAt DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
}

// Structured borrower survey captured at completion.
model RentalExperience {
  id                   String  @id @default(cuid())
  rentalId             String  @unique
  timeToCompleteHours  Float?  // hours (puzzle) or sessions (game)
  difficultyRating     Int? // 1..5
  enjoymentRating      Int? // 1..5
  missingPiecesReported Int    @default(0)
  notes                String?
  createdAt            DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
}

model Dispute {
  id         String        @id @default(cuid())
  rentalId   String        @unique
  openedById String
  status     DisputeStatus @default(OPEN)
  reason     String
  resolution String?
  forfeitCents Int         @default(0) // deposit amount forfeited on resolve
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?

  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  openedBy User   @relation("DisputeOpenedBy", fields: [openedById], references: [id])
}

// Payout ledger. Locks in standing/tier/bonus at COMPLETED so later
// listing/popularity changes never rewrite history.
model RevenueShareEntry {
  id            String  @id @default(cuid())
  rentalId      String  @unique
  ownerId       String? // null for warehouse copies (100% platform)
  feeCents      Int
  ownerStanding Float
  platformFeeBps Int    // basis points, e.g. 3000 = 30%
  popularityBonusBps Int @default(0)
  ownerPayoutCents Int
  platformCents Int
  createdAt     DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  owner  User?  @relation("OwnerPayouts", fields: [ownerId], references: [id])
}

// Money audit trail — every simulated charge/refund/payout.
model SimulatedPayment {
  id          String        @id @default(cuid())
  userId      String?
  rentalId    String?
  type        PaymentType
  status      PaymentStatus @default(SUCCEEDED)
  amountCents Int
  provider    String        @default("simulated")
  reference   String        @unique @default(cuid())
  note        String?
  createdAt   DateTime      @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  rental Rental? @relation(fields: [rentalId], references: [id])

  @@index([type])
}

// ---------------------------------------------------------------------------
// Demand & social signals
// ---------------------------------------------------------------------------

model Favorite {
  id            String   @id @default(cuid())
  userId        String
  catalogItemId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([userId, catalogItemId])
  @@index([catalogItemId])
}

model Review {
  id            String   @id @default(cuid())
  userId        String
  catalogItemId String
  rating        Int // 1..5
  comment       String?
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([userId, catalogItemId])
  @@index([catalogItemId])
}
