# --- Supabase -------------------------------------------------------------
# From your Supabase project: Settings → API.
# SUPABASE_URL is the project URL (e.g. https://xxxx.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY is the service_role key — SERVER-SIDE ONLY, never
# expose it to the browser. All DB access here is server-side.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres connection string — used only by the SQL migration/seed
# scripts (npm run db:reset / db:seed), not by the app at runtime.
# Supabase: Settings → Database → Connection string (URI).
DIRECT_DB_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# --- Auth.js (NextAuth) ---------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-only-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Swappable provider selection -----------------------------------------
PAYMENT_PROVIDER="simulated"   # simulated | stripe
SHIPPING_PROVIDER="simulated"  # simulated | easypost
STORAGE_PROVIDER="simulated"   # simulated | supabase

# --- Shipping policy ------------------------------------------------------
# Who is charged for each leg. MVP default: borrower pays both directions.
SHIPPING_OUTBOUND_PAID_BY="BORROWER"
SHIPPING_RETURN_PAID_BY="BORROWER"
