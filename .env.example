# --- Database -------------------------------------------------------------
# Matches docker-compose.yml. `db` host works inside compose; use localhost
# when running `npm run dev` on the host against the mapped port.
DATABASE_URL="postgresql://jigsaw:jigsaw@localhost:5432/jigsaw?schema=public"

# --- Auth.js (NextAuth) ---------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-only-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Swappable provider selection -----------------------------------------
# Each has exactly one implementation today (the simulated one). Real
# Stripe / carrier / S3 classes drop in behind the same interface later.
PAYMENT_PROVIDER="simulated"   # simulated | stripe
SHIPPING_PROVIDER="simulated"  # simulated | easypost
STORAGE_PROVIDER="simulated"   # simulated | s3

# --- Shipping policy ------------------------------------------------------
# Who is charged for each leg. MVP default: borrower pays both directions.
# outbound/return each: BORROWER | LENDER | PLATFORM
SHIPPING_OUTBOUND_PAID_BY="BORROWER"
SHIPPING_RETURN_PAID_BY="BORROWER"
